{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://huffmanprotocol.org/schemas/assurance-receipt-v0.1.schema.json",
  "title": "Huffman Protocol Assurance Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receipt_id", "issued_at", "expires_at", "verifier", "subject", "suite", "run", "checks", "signature"],
  "properties": {
    "schema": {"const": "huffman-assurance-receipt/0.1"},
    "receipt_id": {"type": "string", "format": "uuid"},
    "issued_at": {"type": "integer", "minimum": 0},
    "expires_at": {"type": "integer", "minimum": 1},
    "verifier": {
      "type": "object", "additionalProperties": false, "required": ["key_id"],
      "properties": {"key_id": {"type": "string", "pattern": "^ed25519:[a-f0-9]{64}$"}}
    },
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["subject_id", "implementation", "version"],
      "properties": {
        "subject_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "implementation": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "suite": {
      "type": "object", "additionalProperties": false, "required": ["suite_id", "version", "sha256"],
      "properties": {
        "suite_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "run": {
      "type": "object", "additionalProperties": false, "required": ["run_id", "challenge_nonce"],
      "properties": {
        "run_id": {"type": "string", "format": "uuid"},
        "challenge_nonce": {"type": "string", "minLength": 16, "maxLength": 256}
      }
    },
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["check_id", "requirement", "outcome", "evidence"],
        "properties": {
          "check_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"},
          "requirement": {"type": "string", "minLength": 1, "maxLength": 512},
          "outcome": {"enum": ["PASS", "FAIL", "INCONCLUSIVE", "NOT_RUN"]},
          "detail": {"type": "string", "maxLength": 1000},
          "evidence": {
            "type": "array", "maxItems": 100,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["kind", "sha256"],
              "properties": {
                "kind": {"type": "string", "minLength": 1, "maxLength": 64},
                "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
              }
            }
          }
        }
      }
    },
    "signature": {"type": "string", "minLength": 1}
  }
}
