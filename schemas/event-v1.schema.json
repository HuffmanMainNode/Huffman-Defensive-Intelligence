{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HDI Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "source_project",
    "occurred_at",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,95}$"
    },
    "source_project": {
      "enum": [
        "oix",
        "open_swarm",
        "halloween_osint",
        "cyber_observatory",
        "hdi"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "schema_version": {
      "const": "1.0"
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_project",
          "source_id",
          "sha256"
        ],
        "properties": {
          "source_project": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "uri": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
